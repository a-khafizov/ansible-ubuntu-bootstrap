# Пример правил UFW для разработчика
# Добавлять командами: sudo ufw allow <правило>

# SSH (стандартный порт 22)
ufw allow OpenSSH

# Веб-разработка
ufw allow 3000/tcp    # React/Vue/Next.js dev server
ufw allow 3001/tcp    # альтернативный порт
ufw allow 8080/tcp    # Spring Boot, Go приложения
ufw allow 8000/tcp    # Python Django/Flask
ufw allow 4200/tcp    # Angular dev server
ufw allow 5173/tcp    # Vite dev server

# Базы данных (рекомендуется только для localhost)
ufw allow from 127.0.0.1 to any port 5432   # PostgreSQL
ufw allow from 127.0.0.1 to any port 3306   # MySQL
ufw allow from 127.0.0.1 to any port 27017  # MongoDB
ufw allow from 127.0.0.1 to any port 6379   # Redis

# Docker (осторожно - может обходить UFW)
# Если нужен доступ к контейнерам извне, добавьте явные правила:
# ufw allow from 192.168.1.0/24 to any port 8080

# Удаление правил:
# sudo ufw delete allow 3000/tcp
# Или по номеру: sudo ufw status numbered -> sudo ufw delete <номер>